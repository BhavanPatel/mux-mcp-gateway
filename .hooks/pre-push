#!/bin/bash
# Pre-push hook: runs build, lint, format check, and tests before allowing push
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo ""
echo "  [pre-push] Running prechecks before push..."
echo ""

# Build
echo "  [1/4] Building..."
if ! BUILD_OUT=$(npm run build 2>&1); then
  echo "        ✖ Build failed:"
  echo "$BUILD_OUT" | tail -20
  exit 1
fi
echo "        ✔ Build passed"

# Lint — eslint's own exit code decides pass/fail (0 = clean incl. under
# --max-warnings default). Do NOT scrape output with a regex: the old BRE `\d`
# was unsupported and `LINT_EXIT=$?` captured the assignment, not eslint, so this
# step always reported "Lint passed". Show output on failure instead of hiding it.
echo "  [2/4] Linting..."
if ! npm run lint; then
  echo "        ✖ Lint failed. Fix before pushing."
  exit 1
fi
echo "        ✔ Lint passed"

# Format check — verify only; never mutate the working tree or stage files
# mid-push. If formatting is off, fail and let the developer run `npm run format`.
echo "  [3/4] Checking formatting..."
if ! npm run format:check; then
  echo "        ✖ Formatting issues. Run 'npm run format' and re-commit."
  exit 1
fi
echo "        ✔ Formatting OK"

# Tests (unit + e2e) — same single path as CI (test:ci). Surface failures.
echo "  [4/4] Running tests..."
if ! TEST_OUT=$(npm run test:ci 2>&1); then
  echo "        ✖ Tests failed:"
  echo "$TEST_OUT" | tail -30
  exit 1
fi
echo "        ✔ Tests passed"

echo ""
echo "  ✔ All prechecks passed. Pushing..."
echo ""
